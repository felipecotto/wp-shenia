{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "1296px", "wideSize": "1440px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        { "slug": "ouro-hero", "name": "Ouro hero", "color": "#BF831E" },
        { "slug": "ouro-areia", "name": "Ouro areia", "color": "#C69B48" },
        { "slug": "ouro-areia-claro", "name": "Ouro areia claro", "color": "#DCC08A" },
        { "slug": "oliva-profundo", "name": "Oliva profundo", "color": "#4A5032" },
        { "slug": "grafite", "name": "Grafite", "color": "#262424" },
        { "slug": "branco", "name": "Branco", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "barlow",
          "name": "Barlow",
          "fontFamily": "Barlow, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Barlow", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-400.woff2"] },
            { "fontFamily": "Barlow", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-500.woff2"] },
            { "fontFamily": "Barlow", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-600.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "nome", "name": "Nome (hero)", "size": "clamp(3.5rem, 1.9rem + 6.6vw, 8rem)" },
        { "slug": "abertura", "name": "Abertura", "size": "clamp(2.25rem, 1.8rem + 1.9vw, 3.5rem)" },
        { "slug": "manifesto", "name": "Manifesto", "size": "clamp(2rem, 1.45rem + 2.3vw, 3.5rem)" },
        { "slug": "secao", "name": "Seção", "size": "clamp(1.75rem, 1.5rem + 1.1vw, 2.5rem)" },
        { "slug": "item", "name": "Item", "size": "clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem)" },
        { "slug": "subitem", "name": "Subitem", "size": "clamp(1.125rem, 1.1rem + 0.2vw, 1.25rem)" },
        { "slug": "intro", "name": "Intro", "size": "clamp(1.125rem, 1rem + 0.6vw, 1.5rem)" },
        { "slug": "corpo-g", "name": "Corpo G", "size": "clamp(1.0625rem, 1rem + 0.3vw, 1.25rem)" },
        { "slug": "corpo", "name": "Corpo", "size": "1rem" },
        { "slug": "legenda", "name": "Legenda", "size": "0.875rem" },
        { "slug": "sobretitulo", "name": "Sobretítulo", "size": "0.8125rem" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": false,
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "4", "size": "0.25rem" },
        { "slug": "20", "name": "8", "size": "0.5rem" },
        { "slug": "30", "name": "16", "size": "1rem" },
        { "slug": "40", "name": "24", "size": "1.5rem" },
        { "slug": "50", "name": "32 a 48", "size": "clamp(2rem, 1.7rem + 1.2vw, 3rem)" },
        { "slug": "60", "name": "48 a 72", "size": "clamp(3rem, 2.5rem + 2.1vw, 4.5rem)" },
        { "slug": "70", "name": "Seção (64 a 128)", "size": "clamp(4rem, 2.8rem + 4.9vw, 8rem)" },
        { "slug": "gutter", "name": "Margem lateral (24 a 72)", "size": "clamp(1.5rem, 0.9rem + 2.5vw, 4.5rem)" }
      ]
    },
    "border": { "radius": true, "color": true, "width": true, "style": true },
    "custom": {
      "raio": { "pilula": "999px" },
      "linha": { "padrao": "1px solid rgba(38, 36, 36, 0.25)", "inversa": "1px solid rgba(255, 255, 255, 0.3)" }
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--ouro-areia)", "text": "var(--wp--preset--color--grafite)" },
    "spacing": {
      "padding": { "left": "var(--wp--preset--spacing--gutter)", "right": "var(--wp--preset--spacing--gutter)" },
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--barlow)",
      "fontSize": "var(--wp--preset--font-size--corpo)",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--barlow)" }, "spacing": { "margin": { "top": "0", "bottom": "0" } } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--abertura)", "fontWeight": "600", "lineHeight": "1.05", "letterSpacing": "-0.02em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--secao)", "fontWeight": "400", "lineHeight": "1.2", "letterSpacing": "-0.01em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--item)", "fontWeight": "500", "lineHeight": "1.25" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--subitem)", "fontWeight": "500", "lineHeight": "1.4" } },
      "link": {
        "color": { "text": "currentColor" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "typography": { "textDecoration": "none" } }
      },
      "button": {
        "color": { "background": "var(--wp--preset--color--grafite)", "text": "var(--wp--preset--color--branco)" },
        "typography": { "fontSize": "1rem", "fontWeight": "500", "lineHeight": "1", "letterSpacing": "0.01em" },
        "border": { "radius": "999px", "width": "0" },
        "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--oliva-profundo)", "text": "var(--wp--preset--color--branco)" } },
        ":focus": { "outline": { "color": "var(--wp--preset--color--grafite)", "offset": "3px", "style": "solid", "width": "2px" } }
      }
    },
    "blocks": {
      "core/paragraph": { "spacing": { "margin": { "top": "0", "bottom": "0" } } },
      "core/list": { "spacing": { "margin": { "top": "0", "bottom": "0" } } },
      "core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--corpo)" } },
      "core/details": { "border": { "top": { "color": "rgba(38, 36, 36, 0.25)", "width": "1px", "style": "solid" } }, "spacing": { "padding": { "top": "1.25rem", "bottom": "1.25rem" } } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Cabeçalho", "area": "header" },
    { "name": "header-imagem", "title": "Cabeçalho sobre imagem", "area": "header" },
    { "name": "footer", "title": "Rodapé", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-sem-titulo", "title": "Página sem título (seções)", "postTypes": ["page"] }
  ]
}
